msgid "Resource Monitor (comparte los mismos atajos NVDA+Shift+1 al 8 y NVDA+Shift+E, causando que se ignoren comandos o se emitan respuestas duplicadas/en inglés)"
msgstr "Resource Monitor (deler de samme genveje NVDA+Shift+1 til 8 og NVDA+Shift+E, hvilket forårsager, at kommandoer ignoreres eller udsendes dublerede/engelske svar)"

msgid "Top Process (superpone atajos o anuncios de consumo de procesos)"
msgstr "Topproces (overlejringsgenveje eller procesforbrugsannoncer)"

msgid "SysInfo (superpone atajos de información de hardware y sistema)"
msgstr "SysInfo (overlejrer hardware- og systeminformationsgenveje)"

msgid "Battery Status (superpone atajos de nivel de batería)"
msgstr "Batteristatus (overlejrer genveje til batteriniveau)"

msgid "Presenta la memoria RAM utilizada y la carga promedio del procesador."
msgstr "Præsenterer den anvendte RAM-hukommelse og den gennemsnitlige processorbelastning."

msgid "Presenta el espacio utilizado y total de la memoria RAM física y virtual. Si se pulsa dos veces, copia la información al portapapeles."
msgstr "Præsenterer det brugte og samlede rum af fysisk og virtuel RAM. Hvis der trykkes to gange, kopieres oplysningerne til udklipsholderen."

msgid "Presenta el espacio utilizado y total de las unidades de disco fijas, extraíbles y de red. Si se pulsa dos veces, copia la información al portapapeles."
msgstr "Viser den brugte og samlede plads til faste, flytbare og netværksdrev. Hvis der trykkes to gange, kopieres oplysningerne til udklipsholderen."

msgid "Anuncia la velocidad y frecuencia actual del procesador (GHz), velocidad base y estado del modo turbo boost. Si se pulsa dos veces, copia la información al portapapeles."
msgstr "Meddeler den aktuelle processorhastighed og -frekvens (GHz), basishastighed og turbo boost-tilstandsstatus. Hvis der trykkes to gange, kopieres oplysningerne til udklipsholderen."

msgid "Anuncia el estado de salud (S.M.A.R.T), temperatura y vida útil de los discos físicos. Si se pulsa dos veces, copia la información al portapapeles."
msgstr "Meddeler sundhedsstatus (S.M.A.R.T), temperatur og levetid for fysiske diske. Hvis der trykkes to gange, kopieres oplysningerne til udklipsholderen."

msgid "Anuncia los procesos que más CPU y RAM consumen actualmente. Si se pulsa dos veces, copia la información al portapapeles."
msgstr "Annoncerer de processer, der i øjeblikket bruger mest CPU og RAM. Hvis der trykkes to gange, kopieres oplysningerne til udklipsholderen."

