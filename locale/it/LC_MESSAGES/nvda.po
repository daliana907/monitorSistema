msgid "Resource Monitor (comparte los mismos atajos NVDA+Shift+1 al 8 y NVDA+Shift+E, causando que se ignoren comandos o se emitan respuestas duplicadas/en inglés)"
msgstr "Monitor risorse (condivide le stesse scorciatoie NVDA+Shift+1 fino a 8 e NVDA+Shift+E, causando l'ignoranza dei comandi o l'emissione di risposte duplicate/in inglese)"

msgid "Top Process (superpone atajos o anuncios de consumo de procesos)"
msgstr "Processo principale (sovrappone scorciatoie o annunci di consumo del processo)"

msgid "SysInfo (superpone atajos de información de hardware y sistema)"
msgstr "SysInfo (sovrappone i collegamenti alle informazioni sull'hardware e sul sistema)"

msgid "Battery Status (superpone atajos de nivel de batería)"
msgstr "Stato della batteria (sovrappone le scorciatoie del livello della batteria)"

msgid "Presenta la memoria RAM utilizada y la carga promedio del procesador."
msgstr "Presenta la memoria RAM utilizzata e il carico medio del processore."

msgid "Presenta el espacio utilizado y total de la memoria RAM física y virtual. Si se pulsa dos veces, copia la información al portapapeles."
msgstr "Presenta lo spazio utilizzato e totale della RAM fisica e virtuale. Se premuto due volte, copia le informazioni negli appunti."

msgid "Presenta el espacio utilizado y total de las unidades de disco fijas, extraíbles y de red. Si se pulsa dos veces, copia la información al portapapeles."
msgstr "Visualizza lo spazio utilizzato e totale per le unità fisse, rimovibili e di rete. Se premuto due volte, copia le informazioni negli appunti."

msgid "Anuncia la velocidad y frecuencia actual del procesador (GHz), velocidad base y estado del modo turbo boost. Si se pulsa dos veces, copia la información al portapapeles."
msgstr "Annuncia la velocità e la frequenza attuali del processore (GHz), la velocità di base e lo stato della modalità turbo boost. Se premuto due volte, copia le informazioni negli appunti."

msgid "Anuncia el estado de salud (S.M.A.R.T), temperatura y vida útil de los discos físicos. Si se pulsa dos veces, copia la información al portapapeles."
msgstr "Annuncia lo stato di salute (S.M.A.R.T), la temperatura e la vita utile dei dischi fisici. Se premuto due volte, copia le informazioni negli appunti."

msgid "Anuncia los procesos que más CPU y RAM consumen actualmente. Si se pulsa dos veces, copia la información al portapapeles."
msgstr "Annuncia i processi che attualmente consumano più CPU e RAM. Se premuto due volte, copia le informazioni negli appunti."

