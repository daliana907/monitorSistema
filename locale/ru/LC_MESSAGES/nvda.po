msgid "Alertas automáticas del sistema"
msgstr "Автоматические системные оповещения"

msgid "Avisar cuando la batería esté completamente cargada (100%)"
msgstr "Уведомлять, когда аккумулятор полностью заряжен (100%)"

msgid "Avisar cuando la batería esté baja (15% o menos)"
msgstr "Уведомлять, когда уровень заряда батареи низкий (15 % или меньше)"

msgid "Avisar si la temperatura del procesador es muy alta (85 °C o más)"
msgstr "Уведомить, если температура процессора очень высокая (85 °C или выше)."

msgid "Batería completamente cargada al 100%. Puedes desconectar el cargador."
msgstr "Аккумулятор полностью заряжен до 100%. Вы можете отключить зарядное устройство."

msgid "Advertencia: Batería baja al {}%. Conecta el equipo a la corriente."
msgstr "Предупреждение: заряд батареи низкий до {}%. Подключите оборудование к электросети."

msgid "Alerta: Temperatura del procesador alta ({})."
msgstr "Предупреждение: высокая температура процессора ({})."

msgid "Anuncia el estado de salud S.M.A.R.T., temperatura y condición de los discos de almacenamiento. Si se pulsa dos veces, copia la información al portapapeles."
msgstr "Объявляет о S.M.A.R.T. состояние здоровья, температура и состояние дисков хранения. При двойном нажатии информация копируется в буфер обмена."

msgid "Anuncia los 5 procesos que consumen más CPU y los 5 que consumen más memoria RAM. Si se pulsa dos veces, copia la información al portapapeles."
msgstr "Объявляет 5 процессов, которые потребляют больше всего ресурсов ЦП, и 5, которые потребляют больше всего оперативной памяти. При двойном нажатии информация копируется в буфер обмена."

msgid "Anuncia la velocidad de descarga y subida de Internet en tiempo real. Si se pulsa dos veces, copia la información al portapapeles."
msgstr "Объявляет скорость загрузки и выгрузки через Интернет в режиме реального времени. При двойном нажатии информация копируется в буфер обмена."

msgid "Anuncia el estado de la batería, tiempo restante y desgaste de salud. Si se pulsa dos veces, copia la información al portapapeles."
msgstr "Сообщает состояние батареи, оставшееся время и износ. При двойном нажатии информация копируется в буфер обмена."

msgid "Anuncia el nivel de batería de los dispositivos Bluetooth conectados. Si se pulsa dos veces, copia la información al portapapeles."
msgstr "Сообщает уровень заряда батареи подключенных устройств Bluetooth. При двойном нажатии информация копируется в буфер обмена."

