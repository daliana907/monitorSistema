msgstr "该系统上不存在键盘快捷键冲突或不兼容的插件。"

msgid "Nota: Los detalles completos también se han registrado en el archivo de log de NVDA."
msgstr "注意：完整的详细信息也已记录在 NVDA 日志文件中。"

msgid "No se pudo obtener la instancia activa de Monitor del Sistema."
msgstr "无法获取系统监视器的活动实例。"

msgid "Monitor del Sistema: No se detectaron conflictos con otros complementos."
msgstr "系统监视器：未检测到与其他插件的冲突。"

msgid "Monitor del Sistema: Se detectaron {count} posibles conflictos o advertencias. Revise el registro de NVDA para más detalles."
msgstr "系统监视器：检测到 {count} 个可能的冲突或警告。检查 NVDA 日志以获取更多详细信息。"

msgid "Comprueba si existen conflictos de atajos de teclado o complementos incompatibles con Monitor del Sistema."
msgstr "检查键盘快捷键冲突或与系统监视器不兼容的插件。"

msgid "El análisis de discos ya está en curso, por favor espera..."
msgstr "磁盘分析已在进行中，请稍候..."

msgid "El análisis de procesos ya está en curso, por favor espera..."
msgstr "流程分析已在进行中，请稍候..."

