msgid "Alertas automáticas del sistema"
msgstr "Автоматични системни сигнали"

msgid "Avisar cuando la batería esté completamente cargada (100%)"
msgstr "Уведомяване, когато батерията е напълно заредена (100%)"

msgid "Avisar cuando la batería esté baja (15% o menos)"
msgstr "Уведомяване, когато батерията е изтощена (15% или по-малко)"

msgid "Avisar si la temperatura del procesador es muy alta (85 °C o más)"
msgstr "Уведомете, ако температурата на процесора е много висока (85 °C или повече)"

msgid "Batería completamente cargada al 100%. Puedes desconectar el cargador."
msgstr "Батерията е напълно заредена на 100%. Можете да изключите зарядното устройство."

msgid "Advertencia: Batería baja al {}%. Conecta el equipo a la corriente."
msgstr "Предупреждение: Ниска батерия до {}%. Свържете оборудването към захранването."

msgid "Alerta: Temperatura del procesador alta ({})."
msgstr "Сигнал: Висока температура на процесора ({})."

msgid "Anuncia el estado de salud S.M.A.R.T., temperatura y condición de los discos de almacenamiento. Si se pulsa dos veces, copia la información al portapapeles."
msgstr "Обявява S.M.A.R.T. здравословно състояние, температура и състояние на дисковете за съхранение. Ако се натисне два пъти, копира информацията в клипборда."

msgid "Anuncia los 5 procesos que consumen más CPU y los 5 que consumen más memoria RAM. Si se pulsa dos veces, copia la información al portapapeles."
msgstr "Обявява 5-те процеса, които консумират най-много CPU и 5-те, които консумират най-много RAM. Ако се натисне два пъти, копира информацията в клипборда."

msgid "Anuncia la velocidad de descarga y subida de Internet en tiempo real. Si se pulsa dos veces, copia la información al portapapeles."
msgstr "Обявява интернет скорост на изтегляне и качване в реално време. Ако се натисне два пъти, копира информацията в клипборда."

msgid "Anuncia el estado de la batería, tiempo restante y desgaste de salud. Si se pulsa dos veces, copia la información al portapapeles."
msgstr "Обявява състоянието на батерията, оставащото време и здравословното износване. Ако се натисне два пъти, копира информацията в клипборда."

msgid "Anuncia el nivel de batería de los dispositivos Bluetooth conectados. Si se pulsa dos veces, copia la información al portapapeles."
msgstr "Обявява нивото на батерията на свързаните Bluetooth устройства. Ако се натисне два пъти, копира информацията в клипборда."

